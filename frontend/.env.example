# Production / Local Backend API Base URL
# Example Render URL: https://kabadidealer-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5001/api

# Production / Local Backend Socket.IO URL
# Example Render URL: https://kabadidealer-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5001

# Map Provider (leaflet is default, openstreetmap tiles)
VITE_MAP_PROVIDER=leaflet
